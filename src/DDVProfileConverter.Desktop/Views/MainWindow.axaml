<Window
    x:Class="DDVProfileConverter.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="640"
    Height="420"
    MinWidth="520"
    MinHeight="340"
    Title="DDV Profile Converter">
  <Grid Margin="32">
    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="12">
      <TextBlock
          HorizontalAlignment="Center"
          FontSize="26"
          FontWeight="SemiBold"
          Text="DDV Profile Converter" />
      <TextBlock
          HorizontalAlignment="Center"
          Opacity="0.72"
          Text="Drop profile.json here" />
    </StackPanel>
  </Grid>
</Window>